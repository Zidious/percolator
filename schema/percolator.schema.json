{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "Config format version; must be 1."
    },
    "grounds": {
      "description": "Named sources of policies, skills, prompts and graph fragments: git repos or local paths.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "git": {
                "type": "string",
                "description": "URL of the git repo the ground is cloned from."
              },
              "ref": {
                "type": "string",
                "description": "Branch, tag or commit to use; perc validate pins it to a commit in percolator.lock."
              }
            },
            "required": [
              "git",
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Local directory used as the ground; ~ is expanded."
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        ],
        "description": "One ground: a git repo at a ref ({ git, ref }) or a local path ({ path })."
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "bindings": {
            "description": "What runs each core stage (intake, groom, plan, implement, review, deliver); all six must be bound.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "intake",
                "groom",
                "plan",
                "implement",
                "review",
                "deliver"
              ]
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "description": "agent, builtin, script or gate; inferred from agent, builtin or command when left out.",
                      "type": "string",
                      "enum": [
                        "agent",
                        "builtin",
                        "script",
                        "gate"
                      ]
                    },
                    "agent": {
                      "description": "Which agent runs the step (agent nodes only).",
                      "type": "string"
                    },
                    "model": {
                      "description": "Model the agent uses (agent nodes only); default the agent's own.",
                      "type": "string"
                    },
                    "effort": {
                      "description": "Reasoning effort for the agent (agent nodes only); default the agent's own.",
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    },
                    "skill": {
                      "description": "One skill the agent loads (agent nodes only).",
                      "type": "string"
                    },
                    "skills": {
                      "description": "Skills the agent loads (agent nodes only).",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "prompt": {
                      "description": "Task prompt for an agent node: inline text, or { from: <ground>, file: … }; {run_id}, {worktree} and the other task variables are filled in; default: carry out the stage contract (bindings) or the node's purpose (hooks).",
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "string",
                              "description": "Name of the ground the prompt file comes from."
                            },
                            "file": {
                              "type": "string",
                              "description": "Prompt file inside the ground."
                            }
                          },
                          "required": [
                            "from",
                            "file"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "builtin": {
                      "description": "Builtin to run: github.intake or github.open_pr (builtin nodes).",
                      "type": "string"
                    },
                    "command": {
                      "description": "Argv array, never a shell string: the script for a script node ({run_dir}, {outputs_dir}, {worktree} filled in), or the program for agent: command.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "before": {
                      "description": "Hook point: run this node before a stage, or before all; at most one of before/after.",
                      "type": "string",
                      "enum": [
                        "intake",
                        "groom",
                        "plan",
                        "implement",
                        "review",
                        "deliver",
                        "all"
                      ]
                    },
                    "after": {
                      "description": "Hook point: run this node after a stage, or after all; at most one of before/after.",
                      "type": "string",
                      "enum": [
                        "intake",
                        "groom",
                        "plan",
                        "implement",
                        "review",
                        "deliver",
                        "all"
                      ]
                    },
                    "once": {
                      "description": "Skip the hook once it has passed in this run, so a loop does not re-run it; default false.",
                      "type": "boolean"
                    },
                    "on_fail": {
                      "description": "Bounded back-edge: on fail, loop back to an earlier stage, up to max_rounds times.",
                      "type": "object",
                      "properties": {
                        "back_to": {
                          "type": "string",
                          "enum": [
                            "intake",
                            "groom",
                            "plan",
                            "implement",
                            "review",
                            "deliver"
                          ],
                          "description": "Earlier stage the run loops back to when this node fails."
                        },
                        "max_rounds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991,
                          "description": "Most rounds the loop may run before escalating to you; required."
                        }
                      },
                      "required": [
                        "back_to",
                        "max_rounds"
                      ],
                      "additionalProperties": false
                    },
                    "max_rounds": {
                      "description": "Round cap for the review loop, read from the last node bound to review; default 3.",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "timeout_s": {
                      "description": "Escalate to you if the step is not done after this many seconds; default no timeout.",
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "escalation": {
                      "description": "Accepted but not used yet; has no effect.",
                      "type": "boolean"
                    },
                    "required": {
                      "description": "Locks the node (in bindings, the whole stage binding): later layers may only restate it unchanged; default false.",
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "description": "agent, builtin, script or gate; inferred from agent, builtin or command when left out.",
                        "type": "string",
                        "enum": [
                          "agent",
                          "builtin",
                          "script",
                          "gate"
                        ]
                      },
                      "agent": {
                        "description": "Which agent runs the step (agent nodes only).",
                        "type": "string"
                      },
                      "model": {
                        "description": "Model the agent uses (agent nodes only); default the agent's own.",
                        "type": "string"
                      },
                      "effort": {
                        "description": "Reasoning effort for the agent (agent nodes only); default the agent's own.",
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          "xhigh",
                          "max"
                        ]
                      },
                      "skill": {
                        "description": "One skill the agent loads (agent nodes only).",
                        "type": "string"
                      },
                      "skills": {
                        "description": "Skills the agent loads (agent nodes only).",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "prompt": {
                        "description": "Task prompt for an agent node: inline text, or { from: <ground>, file: … }; {run_id}, {worktree} and the other task variables are filled in; default: carry out the stage contract (bindings) or the node's purpose (hooks).",
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "from": {
                                "type": "string",
                                "description": "Name of the ground the prompt file comes from."
                              },
                              "file": {
                                "type": "string",
                                "description": "Prompt file inside the ground."
                              }
                            },
                            "required": [
                              "from",
                              "file"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "builtin": {
                        "description": "Builtin to run: github.intake or github.open_pr (builtin nodes).",
                        "type": "string"
                      },
                      "command": {
                        "description": "Argv array, never a shell string: the script for a script node ({run_dir}, {outputs_dir}, {worktree} filled in), or the program for agent: command.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "before": {
                        "description": "Hook point: run this node before a stage, or before all; at most one of before/after.",
                        "type": "string",
                        "enum": [
                          "intake",
                          "groom",
                          "plan",
                          "implement",
                          "review",
                          "deliver",
                          "all"
                        ]
                      },
                      "after": {
                        "description": "Hook point: run this node after a stage, or after all; at most one of before/after.",
                        "type": "string",
                        "enum": [
                          "intake",
                          "groom",
                          "plan",
                          "implement",
                          "review",
                          "deliver",
                          "all"
                        ]
                      },
                      "once": {
                        "description": "Skip the hook once it has passed in this run, so a loop does not re-run it; default false.",
                        "type": "boolean"
                      },
                      "on_fail": {
                        "description": "Bounded back-edge: on fail, loop back to an earlier stage, up to max_rounds times.",
                        "type": "object",
                        "properties": {
                          "back_to": {
                            "type": "string",
                            "enum": [
                              "intake",
                              "groom",
                              "plan",
                              "implement",
                              "review",
                              "deliver"
                            ],
                            "description": "Earlier stage the run loops back to when this node fails."
                          },
                          "max_rounds": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "Most rounds the loop may run before escalating to you; required."
                          }
                        },
                        "required": [
                          "back_to",
                          "max_rounds"
                        ],
                        "additionalProperties": false
                      },
                      "max_rounds": {
                        "description": "Round cap for the review loop, read from the last node bound to review; default 3.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "timeout_s": {
                        "description": "Escalate to you if the step is not done after this many seconds; default no timeout.",
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "escalation": {
                        "description": "Accepted but not used yet; has no effect.",
                        "type": "boolean"
                      },
                      "required": {
                        "description": "Locks the node (in bindings, the whole stage binding): later layers may only restate it unchanged; default false.",
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              ],
              "description": "The node that runs this stage, or a list of nodes run in order."
            }
          },
          "nodes": {
            "description": "Extra nodes by name: hooks, gates and nodes required by rules.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "agent, builtin, script or gate; inferred from agent, builtin or command when left out.",
                  "type": "string",
                  "enum": [
                    "agent",
                    "builtin",
                    "script",
                    "gate"
                  ]
                },
                "agent": {
                  "description": "Which agent runs the step (agent nodes only).",
                  "type": "string"
                },
                "model": {
                  "description": "Model the agent uses (agent nodes only); default the agent's own.",
                  "type": "string"
                },
                "effort": {
                  "description": "Reasoning effort for the agent (agent nodes only); default the agent's own.",
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "skill": {
                  "description": "One skill the agent loads (agent nodes only).",
                  "type": "string"
                },
                "skills": {
                  "description": "Skills the agent loads (agent nodes only).",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "prompt": {
                  "description": "Task prompt for an agent node: inline text, or { from: <ground>, file: … }; {run_id}, {worktree} and the other task variables are filled in; default: carry out the stage contract (bindings) or the node's purpose (hooks).",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "description": "Name of the ground the prompt file comes from."
                        },
                        "file": {
                          "type": "string",
                          "description": "Prompt file inside the ground."
                        }
                      },
                      "required": [
                        "from",
                        "file"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "builtin": {
                  "description": "Builtin to run: github.intake or github.open_pr (builtin nodes).",
                  "type": "string"
                },
                "command": {
                  "description": "Argv array, never a shell string: the script for a script node ({run_dir}, {outputs_dir}, {worktree} filled in), or the program for agent: command.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "before": {
                  "description": "Hook point: run this node before a stage, or before all; at most one of before/after.",
                  "type": "string",
                  "enum": [
                    "intake",
                    "groom",
                    "plan",
                    "implement",
                    "review",
                    "deliver",
                    "all"
                  ]
                },
                "after": {
                  "description": "Hook point: run this node after a stage, or after all; at most one of before/after.",
                  "type": "string",
                  "enum": [
                    "intake",
                    "groom",
                    "plan",
                    "implement",
                    "review",
                    "deliver",
                    "all"
                  ]
                },
                "once": {
                  "description": "Skip the hook once it has passed in this run, so a loop does not re-run it; default false.",
                  "type": "boolean"
                },
                "on_fail": {
                  "description": "Bounded back-edge: on fail, loop back to an earlier stage, up to max_rounds times.",
                  "type": "object",
                  "properties": {
                    "back_to": {
                      "type": "string",
                      "enum": [
                        "intake",
                        "groom",
                        "plan",
                        "implement",
                        "review",
                        "deliver"
                      ],
                      "description": "Earlier stage the run loops back to when this node fails."
                    },
                    "max_rounds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "Most rounds the loop may run before escalating to you; required."
                    }
                  },
                  "required": [
                    "back_to",
                    "max_rounds"
                  ],
                  "additionalProperties": false
                },
                "max_rounds": {
                  "description": "Round cap for the review loop, read from the last node bound to review; default 3.",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "timeout_s": {
                  "description": "Escalate to you if the step is not done after this many seconds; default no timeout.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "escalation": {
                  "description": "Accepted but not used yet; has no effect.",
                  "type": "boolean"
                },
                "required": {
                  "description": "Locks the node (in bindings, the whole stage binding): later layers may only restate it unchanged; default false.",
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "description": "One named node: a hook (with before/after), a gate or a node rules require."
            }
          },
          "rules": {
            "description": "Checks on the merged graph; rules from every layer all apply.",
            "type": "object",
            "properties": {
              "require_skills": {
                "description": "Skills that agent nodes in a stage must load.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "stage": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "intake",
                            "groom",
                            "plan",
                            "implement",
                            "review",
                            "deliver"
                          ]
                        },
                        {
                          "type": "string",
                          "const": "*"
                        }
                      ],
                      "description": "Stage whose agent nodes must load the skills, or * for every stage; a named stage must be bound to an agent node."
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Skills each agent node in that stage must load."
                    }
                  },
                  "required": [
                    "stage",
                    "skills"
                  ],
                  "additionalProperties": false
                }
              },
              "allowed_agents": {
                "description": "Agents nodes may use; default any agent.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowed_models": {
                "description": "Models agent nodes may use; when set, every agent node must name one of them; default any model.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "max_rounds_ceiling": {
                "description": "Highest round cap allowed for the review loop and on_fail back-edges; default no ceiling.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "required_nodes": {
                "description": "Nodes that must be defined: a name, or { name, before | after } to also fix where it attaches.",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Name of the node that must exist."
                        },
                        "before": {
                          "description": "The node must be attached before this stage (or all); exactly one of before/after.",
                          "type": "string",
                          "enum": [
                            "intake",
                            "groom",
                            "plan",
                            "implement",
                            "review",
                            "deliver",
                            "all"
                          ]
                        },
                        "after": {
                          "description": "The node must be attached after this stage (or all); exactly one of before/after.",
                          "type": "string",
                          "enum": [
                            "intake",
                            "groom",
                            "plan",
                            "implement",
                            "review",
                            "deliver",
                            "all"
                          ]
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "use": {
            "description": "Files or dirs from grounds mapped into the run as policy, context, skills, plugins, prompt or graph.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "description": "Name of the ground (under grounds) the file or dir comes from."
                },
                "file": {
                  "description": "File inside the ground to map; exactly one of file or dir.",
                  "type": "string"
                },
                "dir": {
                  "description": "Directory inside the ground to map; exactly one of file or dir.",
                  "type": "string"
                },
                "as": {
                  "type": "string",
                  "enum": [
                    "policy",
                    "context",
                    "skills",
                    "plugins",
                    "prompt",
                    "graph"
                  ],
                  "description": "What the mapping is: policy (binding rules), context (reference), skills, plugins, prompt (accepted but not used yet; has no effect), or graph (a config fragment layer)."
                },
                "applies_to": {
                  "default": [
                    "*"
                  ],
                  "description": "Stages or node names the mapping applies to; default all stages ([\"*\"]).",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "required": {
                  "default": false,
                  "description": "Locks the mapping: later layers may only restate it unchanged; default false.",
                  "type": "boolean"
                }
              },
              "required": [
                "from",
                "as"
              ],
              "additionalProperties": false
            }
          },
          "match": {
            "description": "Which repos use this profile; the first matching profile wins; without it, only --profile picks it.",
            "type": "object",
            "properties": {
              "remote": {
                "description": "Glob or globs matched against the repo's remote URL.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "path": {
                "description": "Glob or globs matched against the repo's path; ~ is expanded.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "tracker": {
            "description": "Issue tracker used for tickets, gates and pull requests.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "github",
                "description": "Tracker type; only github."
              },
              "approvers": {
                "description": "GitHub logins whose approve/reject comments count at a gate; default the gh user running perc.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "runtime": {
            "description": "How runs are set up: worktrees, base branch, terminals and the Herdr space.",
            "type": "object",
            "properties": {
              "worktree_root": {
                "description": "Put worktrees under <root>/<repo>/; relative to the config file, ~ expanded; default <repo>/.worktrees.",
                "type": "string"
              },
              "base": {
                "description": "Branch the run starts from and opens its PR against; detected from the repo when left out.",
                "type": "string"
              },
              "keep_terminals": {
                "description": "Keep step terminals open after they finish; default false.",
                "type": "boolean"
              },
              "space": {
                "description": "Create a Herdr space per run; default true (false skips it).",
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "trust_repo_config": {
            "description": "Load the repo's own config file as the last layer; default false (refused).",
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "One profile: the graph, tracker and runtime settings for the repos it matches."
      },
      "description": "Named profiles; the first whose match fits the repo wins, or pick one with --profile."
    }
  },
  "required": [
    "version",
    "profiles"
  ],
  "additionalProperties": false
}
