{
  "name": "percolator",
  "version": "0.1.0",
  "description": "Deterministic ticket-to-PR pipeline engine",
  "type": "module",
  "bin": {
    "perc": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "schema": "node src/config/json-schema.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
