{
  "name": "percolator",
  "version": "0.1.0",
  "description": "Deterministic ticket-to-PR pipeline engine",
  "type": "module",
  "bin": {
    "perc": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "schema",
    "skills",
    "templates"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./schema.json": "./schema/percolator.schema.json"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "schema": "node src/config/json-schema.ts",
    "herdr:sync": "node -e \"const p=require('node:path'),h=process.env.HERDR_APP_HOME||p.join(require('node:os').homedir(),'.config','herdr-app');for(const m of ['percolator','percolator-cup']){require('node:fs').cpSync(p.join('herdr','mods',m),p.join(h,'mods',m),{recursive:true});console.log('synced '+m+' -> '+p.join(h,'mods',m))}\""
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
